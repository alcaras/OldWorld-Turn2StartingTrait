<?xml version="1.0" encoding="UTF-8"?>
<!-- Fired from code (TraitModPlayer, right after the leader is created), not by a
     trigger: it must reach exactly the players this mod applies to, and only once
     their leader exists. Hence no Trigger / iWeight. -->
<Root>
	<Entry>
		<zType>EVENTSTORY_OWTRAITMOD_UNWRITTEN_REPUTATION</zType>
		<Name>TEXT_EVENTSTORY_OWTRAITMOD_UNWRITTEN_REPUTATION_TITLE</Name>
		<Text>TEXT_EVENTSTORY_OWTRAITMOD_UNWRITTEN_REPUTATION</Text>
		<zBackgroundName>crowning_01</zBackgroundName>
		<!-- Subject 1 exists so the text can say {PLAYER-1}: a Character subject emits the
		     CHARACTER-* keys but never PLAYER-, so the nation needs a subject of its own. -->
		<aeSubjects>
			<zValue>SUBJECT_LEADER_US</zValue>
			<zValue>SUBJECT_PLAYER_US</zValue>
		</aeSubjects>
		<aeOptions>
			<zValue>EVENTOPTION_OWTRAITMOD_UNWRITTEN_REPUTATION_OK</zValue>
		</aeOptions>
		<iImageSubject>0</iImageSubject>
		<iPriority>20</iPriority>
		<iRepeatTurns>-1</iRepeatTurns>
	</Entry>
</Root>
